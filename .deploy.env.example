# Cấu hình deploy từ Mac. Copy file này thành .deploy.env rồi sửa.
# .deploy.env đã bị .gitignore bỏ qua — IP / user thật chỉ để trong .deploy.env.

# ===== deploy.sh → server CentOS (Docker compose) =====
# --- Kết nối SSH ---
SERVER_USER=root
SERVER_HOST="<IP_LAN>"            # LAN. Đi xa: đổi thành IP public qua FortiGate (<IP_PUBLIC>)
SSH_PORT=22                       # Nếu FortiGate forward SSH sang port khác thì sửa ở đây
REMOTE_DIR=/home/ai-office

# --- Health check chạy TRÊN server ---
# Để trống/không đặt: deploy.sh tự đọc APP_PORT trong .env trên server
# (cổng phía host) → http://127.0.0.1:<APP_PORT>/api/health.
#HEALTH_URL=http://127.0.0.1:8080/api/health

# --- skills/ ---
# 1 = đẩy cả skills/ và GHI ĐÈ nhật ký tự học Hermes trên server.
# 0 = giữ nguyên skills/ trên server (khuyến nghị).
SYNC_SKILLS=0

# ===== update-from-mac.sh → GitHub → VPS Windows (NSSM) =====
VPS_USER=Administrator
VPS_HOST="<IP_VPS>"
VPS_SSH_PORT=22
VPS_DEPLOY_SCRIPT=C:/ai-office/deploy-windows.ps1
