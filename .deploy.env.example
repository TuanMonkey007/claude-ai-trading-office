# Cấu hình deploy (Mac → server CentOS). Copy file này thành .deploy.env rồi sửa.
# .deploy.env đã bị .gitignore bỏ qua.

# --- Kết nối SSH ---
SERVER_USER=root
SERVER_HOST=10.10.101.22          # LAN. Đi xa: đổi thành IP public qua FortiGate, ví dụ 27.72.104.150
SSH_PORT=22                       # Nếu FortiGate forward SSH sang port khác thì sửa ở đây
REMOTE_DIR=/home/ai-office

# --- Health check chạy TRÊN server (localhost = cổng container) ---
HEALTH_URL=http://127.0.0.1:8080/api/health

# --- skills/ ---
# 1 = đẩy cả skills/ và GHI ĐÈ nhật ký tự học Hermes trên server.
# 0 = giữ nguyên skills/ trên server (khuyến nghị).
SYNC_SKILLS=0
