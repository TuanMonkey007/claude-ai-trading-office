# APP_NAME: tên container. COMPOSE_PROJECT_NAME: tên project (image sẽ là <project>-app), chỉ chữ thường, số, gạch ngang
APP_NAME=ai-trading-office
COMPOSE_PROJECT_NAME=ai-trading-office
# APP_PORT = cổng PHÍA HOST mà docker compose map vào cổng 8080 bên trong container
# ("${APP_PORT}:8080"). Đổi APP_PORT thì sửa luôn firewalld / FortiGate cho khớp.
# deploy.sh đọc APP_PORT từ .env trên server để health check đúng cổng.
APP_PORT=18080
# KHÔNG đặt OFFICE_PORT ở đây: file này được nạp vào container (env_file) và server.py
# sẽ nghe sai cổng (compose chỉ map vào 8080 của container).
# Chạy native trên Windows (NSSM): OFFICE_PORT đặt trong service NSSM
# (setup-windows-service.ps1, biến $OFFICE_PORT), không đặt trong .env dùng chung.
# Đăng nhập dashboard (BẮT BUỘC đổi mật khẩu trước khi mở cổng ra Internet)
OFFICE_ADMIN_USER=admin
OFFICE_ADMIN_PASSWORD=doi-mat-khau-nay
