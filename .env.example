# APP_NAME: tên container. COMPOSE_PROJECT_NAME: tên project (image sẽ là <project>-app), chỉ chữ thường, số, gạch ngang
APP_NAME=ai-trading-office
COMPOSE_PROJECT_NAME=ai-trading-office
# Cổng trên host CentOS
APP_PORT=8080
# Đăng nhập dashboard
OFFICE_ADMIN_USER=admin
OFFICE_ADMIN_PASSWORD=doi-mat-khau-nay
